{{ 'cesar-footer.css' | asset_url | stylesheet_tag }}

<footer class="cesar-footer color-{{ section.settings.color_scheme }}">
  <div class="cc-container cesar-footer__top">
    {%- for block in section.blocks -%}
      {%- case block.type -%}

        {%- when 'brand' -%}
          <div class="cesar-footer__col cesar-footer__brand" {{ block.shopify_attributes }}>
            {%- assign footer_logo = block.settings.logo | default: settings.logo -%}
            {%- if footer_logo != blank -%}
              <div class="cesar-footer__logo-frame{% if block.settings.logo_invert %} cesar-footer__logo-frame--invert{% endif %}">
                {{
                  footer_logo
                  | image_url: width: 300
                  | image_tag:
                    loading: 'lazy',
                    widths: '100, 150, 200, 300',
                    class: 'cesar-footer__logo',
                    alt: shop.name
                }}
              </div>
            {%- endif -%}

            {%- if block.settings.address != blank -%}
              <div class="cesar-footer__address rte">{{ block.settings.address }}</div>
            {%- endif -%}

            {%- if block.settings.show_social -%}
              {%- if block.settings.social_heading != blank -%}
                <p class="cesar-footer__social-heading">{{ block.settings.social_heading }}</p>
              {%- endif -%}
              {%- render 'social-icons', class: 'cesar-footer__social' -%}
            {%- endif -%}
          </div>

        {%- when 'newsletter' -%}
          <div class="cesar-footer__col cesar-footer__newsletter" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h2 class="cesar-footer__heading">{{ block.settings.heading }}</h2>
            {%- endif -%}

            {% form 'customer', class: 'cesar-newsletter' %}
              <input type="hidden" name="contact[tags]" value="newsletter">

              {%- if block.settings.show_phone -%}
                <div class="cesar-newsletter__field">
                  <label class="cesar-newsletter__label" for="FooterPhone--{{ section.id }}">
                    {{ block.settings.phone_label }}
                  </label>
                  <input
                    id="FooterPhone--{{ section.id }}"
                    type="tel"
                    name="contact[phone]"
                    class="cesar-newsletter__input"
                    autocomplete="tel"
                    placeholder="{{ block.settings.phone_label }}"
                  >
                </div>
              {%- endif -%}

              <div class="cesar-newsletter__field">
                <label class="cesar-newsletter__label" for="FooterEmail--{{ section.id }}">
                  {{ block.settings.email_label }}
                </label>
                <input
                  id="FooterEmail--{{ section.id }}"
                  type="email"
                  name="contact[email]"
                  class="cesar-newsletter__input"
                  value="{{ form.email }}"
                  autocorrect="off"
                  autocapitalize="off"
                  autocomplete="email"
                  placeholder="{{ block.settings.email_label }}"
                  required
                  aria-required="true"
                  {% if form.errors %}
                    aria-invalid="true"
                    aria-describedby="FooterNewsletterError--{{ section.id }}"
                  {% endif %}
                >
              </div>

              {%- if form.errors -%}
                <p class="cesar-newsletter__error" id="FooterNewsletterError--{{ section.id }}" role="alert">
                  {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
                </p>
              {%- endif -%}

              {%- if block.settings.legal != blank -%}
                <div class="cesar-newsletter__legal rte">{{ block.settings.legal }}</div>
              {%- endif -%}

              <button type="submit" class="cesar-newsletter__button" name="commit">
                {{ block.settings.button_label | default: 'Subscribe' }}
              </button>

              {%- if form.posted_successfully? -%}
                <p class="cesar-newsletter__success" role="status">
                  {{ 'newsletter.success' | t }}
                </p>
              {%- endif -%}
            {% endform %}
          </div>

        {%- when 'menu' -%}
          <div class="cesar-footer__col cesar-footer__menu" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h2 class="cesar-footer__heading">{{ block.settings.heading }}</h2>
            {%- endif -%}
            {%- if block.settings.menu != blank -%}
              <ul class="cesar-footer__links" role="list">
                {%- for link in block.settings.menu.links -%}
                  <li>
                    <a href="{{ link.url }}" class="cesar-footer__link">{{ link.title }}</a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>

      {%- endcase -%}
    {%- endfor -%}
  </div>

  <div class="cesar-footer__bottom color-{{ section.settings.bottom_color_scheme }}">
    <div class="cc-container cesar-footer__bottom-inner">
      <div class="cesar-footer__legal-left">
        <p class="cesar-footer__copyright">
          &copy; {{ 'now' | date: '%Y' }} {{ section.settings.copyright_name | default: shop.name }}.
          {{ section.settings.rights_text }}
        </p>
        {%- if section.settings.disclaimer != blank -%}
          <p class="cesar-footer__disclaimer">{{ section.settings.disclaimer }}</p>
        {%- endif -%}
      </div>

      {%- if section.settings.policy_menu != blank -%}
        <ul class="cesar-footer__policies" role="list">
          {%- for link in section.settings.policy_menu.links -%}
            <li><a href="{{ link.url }}" class="cesar-footer__policy-link">{{ link.title }}</a></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Cesar · Footer",
  "tag": "footer",
  "class": "cesar-footer-section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-4"
    },
    {
      "type": "header",
      "content": "Barra inferior"
    },
    {
      "type": "color_scheme",
      "id": "bottom_color_scheme",
      "label": "Esquema de la barra inferior",
      "default": "scheme-3"
    },
    {
      "type": "text",
      "id": "copyright_name",
      "label": "Nombre en el copyright",
      "info": "Si se deja vacío se usa el nombre de la tienda."
    },
    {
      "type": "text",
      "id": "rights_text",
      "label": "Texto de derechos",
      "default": "All Rights Reserved"
    },
    {
      "type": "text",
      "id": "disclaimer",
      "label": "Aviso legal",
      "default": "All product names, images and details on this site are for illustrative purposes only and may vary from the final product."
    },
    {
      "type": "link_list",
      "id": "policy_menu",
      "label": "Menú de políticas",
      "info": "Se gestiona en Tienda online → Navegación."
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Marca",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo",
          "info": "Si se deja vacío se usa el logo general del tema."
        },
        {
          "type": "checkbox",
          "id": "logo_invert",
          "label": "Pasar el logo a blanco",
          "default": false,
          "info": "Sólo funciona con logos de un color plano. El logo actual tiene relleno blanco interior y saldría como una mancha: para el footer conviene subir una versión ya en blanco."
        },
        {
          "type": "richtext",
          "id": "address",
          "label": "Dirección y horario",
          "default": "<p>19 Churchill St,<br/>North Williamstown,<br/>VIC 3016<br/>Mon–Fri 8:00 AM–5:00 PM</p>"
        },
        {
          "type": "checkbox",
          "id": "show_social",
          "label": "Mostrar redes sociales",
          "default": true
        },
        {
          "type": "text",
          "id": "social_heading",
          "label": "Título de redes",
          "default": "Follow Us"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Título"
        },
        {
          "type": "text",
          "id": "email_label",
          "label": "Etiqueta del email",
          "default": "Email Address"
        },
        {
          "type": "checkbox",
          "id": "show_phone",
          "label": "Pedir también el móvil",
          "default": false,
          "info": "Actívalo sólo si hay una app de SMS conectada que capture el teléfono. Si no, el campo se envía pero no se guarda en ningún sitio."
        },
        {
          "type": "text",
          "id": "phone_label",
          "label": "Etiqueta del móvil",
          "default": "Mobile Number"
        },
        {
          "type": "richtext",
          "id": "legal",
          "label": "Texto legal"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Botón",
          "default": "Subscribe"
        }
      ]
    },
    {
      "type": "menu",
      "name": "Columna de enlaces",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Título",
          "default": "Our Story"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menú",
          "info": "Se gestiona en Tienda online → Navegación."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cesar · Footer",
      "blocks": [
        { "type": "brand" },
        { "type": "newsletter" },
        { "type": "menu", "settings": { "heading": "Our Story" } },
        { "type": "menu", "settings": { "heading": "Help Center" } }
      ]
    }
  ]
}
{% endschema %}
