{{ 'cesar-card.css' | asset_url | stylesheet_tag }}
{{ 'cesar-collection-row.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}

<div class="cesar-collection-row cc-section color-{{ section.settings.color_scheme }}">
  <div class="cc-container cesar-collection-row__inner">
    {%- comment -%} Columna de texto: titular, texto y una sola llamada a la acción. {%- endcomment -%}
    <div class="cesar-collection-row__intro">
      {%- if section.settings.heading != blank -%}
        <h2 class="cesar-collection-row__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <p class="cesar-collection-row__text">{{ section.settings.text }}</p>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="cc-btn cc-btn--primary cesar-collection-row__button">
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>

    {%- comment -%}
      Carrusel de cards informativas. Cada una enlaza a una página o a un
      artículo del blog, no a un producto.
      Se usa el slider-component de Dawn en vez de uno propio: ya trae los
      botones, el contador, el arrastre y el manejo de foco y teclado.
    {%- endcomment -%}
    <slider-component class="cesar-collection-row__slider slider-mobile-gutter">
      {%- comment -%}
        Las clases grid de Dawn son las que dan el ancho a cada slide
        (.grid--N-col-desktop .grid__item). Sin ellas los slides salen a ancho
        completo y apilados.
      {%- endcomment -%}
      <ul
        id="Slider-{{ section.id }}"
        data-id="{{ section.id }}"
        class="cesar-collection-row__grid cesar-slider grid grid--{{ section.settings.columns_desktop }}-col-desktop grid--{{ section.settings.columns_mobile }}-col-tablet-down slider slider--desktop slider--tablet"
        style="--cc-cards: {{ section.settings.columns_desktop }};"
        role="list"
        aria-label="{{ 'general.slider.name' | t }}"
      >
        {%- for block in section.blocks -%}
          <li
            id="Slide-{{ section.id }}-{{ forloop.index }}"
            class="grid__item slider__slide"
            {{ block.shopify_attributes }}
          >
            {% render 'cesar-image-card',
              image: block.settings.image,
              title: block.settings.title,
              text: block.settings.text,
              link_label: block.settings.link_label,
              link: block.settings.link,
              ratio: 'portrait',
              sizes: '(min-width: 990px) 25vw, 70vw'
            %}
          </li>
        {%- endfor -%}
      </ul>

      {%- if section.blocks.size > 1 -%}
        <div class="slider-buttons">
          <button
            type="button"
            class="slider-button slider-button--prev"
            name="previous"
            aria-label="{{ 'general.slider.previous_slide' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
          </button>
          {%- comment -%} Indicador común de todos los carruseles {%- endcomment -%}
          <cesar-slider-dots></cesar-slider-dots>
          <button
            type="button"
            class="slider-button slider-button--next"
            name="next"
            aria-label="{{ 'general.slider.next_slide' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
          </button>
        </div>
      {%- endif -%}
    </slider-component>
  </div>
</div>

{% schema %}
{
  "name": "Cesar · Texto y carrusel",
  "tag": "section",
  "class": "cesar-collection-row-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titular",
      "default": "Retail proof. Trade ready."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texto",
      "default": "Wholesale roast-to-order, white-label roasting, co-roasting and roaster hire — for cafés, venues and roasters who want what's in the bag."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Botón",
      "default": "Talk To Us About Trade"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del botón"
    },
    {
      "type": "header",
      "content": "Carrusel"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Cards visibles en escritorio",
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Cards visibles en móvil",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "1"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-3"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "wholesale"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Descripción"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Enlace",
          "default": "See Our Farms"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Destino",
          "info": "Una página o un artículo del blog."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cesar · Texto y carrusel",
      "blocks": [
        { "type": "card", "settings": { "title": "wholesale", "link_label": "See Our Farms" } },
        { "type": "card", "settings": { "title": "white-label", "link_label": "How We Roast" } },
        { "type": "card", "settings": { "title": "co-roasting", "link_label": "How We Roast" } }
      ]
    }
  ]
}
{% endschema %}
