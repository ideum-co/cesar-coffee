{{ 'cesar-collection-row.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign products = section.settings.collection.products
  assign products_to_display = products.size
  if products_to_display > section.settings.products_to_show
    assign products_to_display = section.settings.products_to_show
  endif
-%}

<div class="cesar-collection-row cc-section color-{{ section.settings.color_scheme }}">
  <div class="cc-container cesar-collection-row__inner">
    {%- comment -%} Columna de texto: titular, texto y una sola llamada a la acción. {%- endcomment -%}
    <div class="cesar-collection-row__intro">
      {%- if section.settings.heading != blank -%}
        <h2 class="cesar-collection-row__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <p class="cesar-collection-row__text">{{ section.settings.text }}</p>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a
          href="{{ section.settings.button_link | default: section.settings.collection.url | default: '#' }}"
          class="cc-btn cc-btn--primary cesar-collection-row__button"
        >
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>

    {%- comment -%}
      Carrusel. Se usa el slider-component de Dawn en vez de uno propio: ya trae
      los botones, el contador, el arrastre y el manejo de foco y teclado.
    {%- endcomment -%}
    <slider-component class="cesar-collection-row__slider slider-mobile-gutter">
      <ul
        id="Slider-{{ section.id }}"
        data-id="{{ section.id }}"
        class="cesar-collection-row__grid grid product-grid contains-card contains-card--product slider slider--desktop slider--tablet grid--peek"
        role="list"
        aria-label="{{ 'general.slider.name' | t }}"
      >
        {%- for product in products limit: section.settings.products_to_show -%}
          <li
            id="Slide-{{ section.id }}-{{ forloop.index }}"
            class="grid__item slider__slide"
          >
            {% render 'card-product',
              card_product: product,
              media_aspect_ratio: section.settings.image_ratio,
              show_rating: section.settings.show_rating,
              show_secondary_image: false,
              section_id: section.id
            %}
          </li>
        {%- else -%}
          {%- comment -%}
            Sin colección elegida (o vacía) se muestran marcadores, para que la
            sección se pueda componer en el editor antes de tener catálogo.
          {%- endcomment -%}
          {%- for i in (1..3) -%}
            <li class="grid__item slider__slide">
              {% render 'card-product', show_rating: section.settings.show_rating, section_id: section.id %}
            </li>
          {%- endfor -%}
        {%- endfor -%}
      </ul>

      {%- if products_to_display > 1 -%}
        <div class="slider-buttons">
          <button
            type="button"
            class="slider-button slider-button--prev"
            name="previous"
            aria-label="{{ 'general.slider.previous_slide' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
          </button>
          <div class="slider-counter caption">
            <span class="slider-counter--current">1</span>
            <span aria-hidden="true"> / </span>
            <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
            <span class="slider-counter--total">{{ products_to_display }}</span>
          </div>
          <button
            type="button"
            class="slider-button slider-button--next"
            name="next"
            aria-label="{{ 'general.slider.next_slide' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
          </button>
        </div>
      {%- endif -%}
    </slider-component>
  </div>
</div>

{% schema %}
{
  "name": "Cesar · Texto y carrusel",
  "tag": "section",
  "class": "cesar-collection-row-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titular",
      "default": "Retail proof. Trade ready."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texto",
      "default": "Roasted to order for cafés, offices and stockists across Melbourne."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Botón",
      "default": "Talk To Us"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del botón",
      "info": "Si se deja vacío se usa la colección elegida."
    },
    {
      "type": "header",
      "content": "Carrusel"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Colección"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Productos",
      "default": 6
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Proporción de la imagen",
      "options": [
        { "value": "adapt", "label": "Adaptar" },
        { "value": "portrait", "label": "Vertical" },
        { "value": "square", "label": "Cuadrada" }
      ],
      "default": "square"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Mostrar valoración",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-5"
    }
  ],
  "presets": [
    {
      "name": "Cesar · Texto y carrusel"
    }
  ]
}
{% endschema %}
