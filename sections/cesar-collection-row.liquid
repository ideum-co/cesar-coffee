{{ 'cesar-card.css' | asset_url | stylesheet_tag }}
{{ 'cesar-collection-row.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Los colores y la alineación viajan como variables en línea, y sólo se escriben
  si tienen valor: sin tocarlas la sección sigue con su esquema de color.
{%- endcomment -%}
{%- liquid
  comment
    El origen de las cards. Si se pide el blog pero aún no hay ninguno elegido
    —o el elegido está vacío— se siguen usando los bloques manuales: así la
    sección nunca aparece en blanco mientras se termina de configurar.
  endcomment
  assign usar_blog = false
  if section.settings.source == 'blog' and section.settings.blog != blank and section.settings.blog.articles_count > 0
    assign usar_blog = true
    assign articulos = section.settings.blog.articles
    assign total_cards = section.settings.blog.articles_count
    if total_cards > section.settings.articles_to_show
      assign total_cards = section.settings.articles_to_show
    endif
  else
    assign total_cards = section.blocks.size
  endif
-%}

{%- capture row_style -%}
  {% if section.settings.bg_color != blank %}--cesar-sec-bg: {{ section.settings.bg_color }};{% endif %}
  {% if section.settings.heading_color != blank %}--cesar-sec-heading: {{ section.settings.heading_color }};{% endif %}
  {% if section.settings.text_color != blank %}--cesar-sec-text: {{ section.settings.text_color }};{% endif %}
  {% if section.settings.button_bg != blank %}--cesar-btn-bg: {{ section.settings.button_bg }};{% endif %}
  {% if section.settings.button_text != blank %}--cesar-btn-text: {{ section.settings.button_text }};{% endif %}
{%- endcapture -%}
<div
  class="cesar-collection-row cc-section cesar-sec cesar-sec--align-{{ section.settings.text_alignment }} color-{{ section.settings.color_scheme }}"
  {% if row_style != blank %}style="{{ row_style | strip_newlines | strip }}"{% endif %}
>
  <div class="cc-container cesar-collection-row__inner">
    {%- comment -%} Columna de texto: titular, texto y una sola llamada a la acción. {%- endcomment -%}
    <div class="cesar-collection-row__intro">
      {%- if section.settings.heading != blank -%}
        <h2 class="cesar-collection-row__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <p class="cesar-collection-row__text">{{ section.settings.text }}</p>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="cc-btn cc-btn--primary cesar-collection-row__button">
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>

    {%- comment -%}
      Carrusel de cards informativas. Cada una enlaza a una página o a un
      artículo del blog, no a un producto.
      Se usa el slider-component de Dawn en vez de uno propio: ya trae los
      botones, el contador, el arrastre y el manejo de foco y teclado.
    {%- endcomment -%}
    <slider-component class="cesar-collection-row__slider slider-mobile-gutter">
      {%- comment -%}
        Sin grid--N-col-desktop a propósito. Esa clase activa el cálculo de
        ancho de Dawn, que descuenta un margen inicial y cuatro gutters y deja
        las cards demasiado estrechas. Como vive en component-slider.css, que
        la sección carga en el body, ganaba por orden a cualquier regla nuestra
        del head. Al no ponerla, manda el reparto exacto por --cc-cards.
        En móvil sí se usa la clase de Dawn, donde su cálculo sí encaja.
      {%- endcomment -%}
      <div class="cesar-slider__viewport">
      <ul
        id="Slider-{{ section.id }}"
        data-id="{{ section.id }}"
        class="cesar-collection-row__grid cesar-slider grid grid--{{ section.settings.columns_mobile }}-col-tablet-down slider slider--desktop slider--tablet"
        style="--cc-cards: {{ section.settings.columns_desktop }};"
        role="list"
        aria-label="{{ 'general.slider.name' | t }}"
      >
        {%- if usar_blog -%}
          {%- for article in articulos limit: section.settings.articles_to_show -%}
            {%- liquid
              assign resumen = ''
              if section.settings.show_excerpt
                if article.excerpt != blank
                  assign resumen = article.excerpt | strip_html | truncatewords: 18
                else
                  assign resumen = article.content | strip_html | truncatewords: 18
                endif
              endif
            -%}
            <li id="Slide-{{ section.id }}-{{ forloop.index }}" class="grid__item slider__slide">
              {% render 'cesar-image-card',
                image: article.image,
                title: article.title,
                text: resumen,
                link_label: section.settings.article_button_label,
                link: article.url,
                ratio: 'portrait',
                sizes: '(min-width: 990px) 25vw, 70vw'
              %}
            </li>
          {%- endfor -%}
        {%- else -%}
          {%- for block in section.blocks -%}
            <li
              id="Slide-{{ section.id }}-{{ forloop.index }}"
              class="grid__item slider__slide"
              {{ block.shopify_attributes }}
            >
              {% render 'cesar-image-card',
                image: block.settings.image,
                title: block.settings.title,
                text: block.settings.text,
                link_label: block.settings.link_label,
                link: block.settings.link,
                ratio: 'portrait',
                sizes: '(min-width: 990px) 25vw, 70vw'
              %}
            </li>
          {%- endfor -%}
        {%- endif -%}
      </ul>
          <button
            type="button"
            class="slider-button slider-button--prev cesar-slider__arrow cesar-slider__arrow--prev"
            name="previous"
            aria-label="{{ 'general.slider.previous_slide' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
          </button>
          <button
            type="button"
            class="slider-button slider-button--next cesar-slider__arrow cesar-slider__arrow--next"
            name="next"
            aria-label="{{ 'general.slider.next_slide' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
          </button>
      </div>

      {%- if total_cards > 1 -%}
        <div class="slider-buttons">
          {%- comment -%} Indicador común de todos los carruseles {%- endcomment -%}
          <cesar-slider-dots></cesar-slider-dots>
        </div>
      {%- endif -%}
    </slider-component>
  </div>
</div>

{% schema %}
{
  "name": "Cesar · Texto y carrusel",
  "tag": "section",
  "class": "cesar-collection-row-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titular",
      "default": "Retail proof. Trade ready."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texto",
      "default": "Wholesale roast-to-order, white-label roasting, co-roasting and roaster hire — for cafés, venues and roasters who want what's in the bag."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Botón",
      "default": "Talk To Us About Trade"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del botón"
    },
    {
      "type": "header",
      "content": "Carrusel"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Cards visibles en escritorio",
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Cards visibles en móvil",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "1"
    },
    {
      "type": "header",
      "content": "Origen de las cards"
    },
    {
      "type": "select",
      "id": "source",
      "label": "Qué se muestra",
      "options": [
        {
          "value": "blog",
          "label": "Entradas del blog"
        },
        {
          "value": "blocks",
          "label": "Cards escritas a mano"
        }
      ],
      "default": "blog",
      "info": "Con \"Entradas del blog\", cada card usa la imagen destacada de fondo, el título de la entrada y un botón que lleva a ella. Mientras no elijas blog se siguen viendo las cards escritas a mano."
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "articles_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Entradas a mostrar",
      "default": 6
    },
    {
      "type": "text",
      "id": "article_button_label",
      "label": "Texto del botón de la entrada",
      "default": "Read the story"
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Mostrar un resumen bajo el título",
      "default": false,
      "info": "En el diseño la card lleva sólo el título y el botón."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-3"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Alineación del texto",
      "options": [
        {
          "value": "left",
          "label": "Izquierda"
        },
        {
          "value": "center",
          "label": "Centro"
        },
        {
          "value": "right",
          "label": "Derecha"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Colores"
    },
    {
      "type": "paragraph",
      "content": "Todos opcionales. Vacíos, la sección usa su esquema de color. Al cambiarlos comprueba que el texto siga leyéndose sobre el fondo."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Fondo de la sección"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Titular"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Texto"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Fondo del botón"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Texto del botón"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "wholesale"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Descripción"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Enlace",
          "default": "See Our Farms"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Destino",
          "info": "Una página o un artículo del blog."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cesar · Texto y carrusel",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "title": "wholesale",
            "link_label": "See Our Farms"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "white-label",
            "link_label": "How We Roast"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "co-roasting",
            "link_label": "How We Roast"
          }
        }
      ]
    }
  ]
}
{% endschema %}
