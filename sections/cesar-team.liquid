{{ 'cesar-team.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Equipo: retrato, nombre, cargo y una línea sobre cada persona.
{%- endcomment -%}

{%- capture cesar_style -%}
  {% render 'cesar-section-style', s: section.settings %}
  {% if section.settings.limit_width %}--cesar-team-max: {{ section.settings.max_width }}px;{% endif %}
  --cesar-team-cols: {{ section.settings.columns_desktop }};
  {% if section.settings.role_color != blank %}--cesar-team-role: {{ section.settings.role_color }};{% endif %}
  {% if section.settings.name_px > 0 %}--cesar-team-name-size: {{ section.settings.name_px }}px;{% endif %}
{%- endcapture -%}

<div
  class="cesar-team cesar-sec cc-section color-{{ section.settings.color_scheme }}"
  {% if cesar_style != blank %}style="{{ cesar_style | strip_newlines | strip }}"{% endif %}
>
  <div class="cesar-team__container cc-container{% if section.settings.limit_width %} cesar-team__container--limited{% endif %}">
    {%- if section.settings.caption != blank or section.settings.heading != blank or section.settings.text != blank -%}
      <div class="cesar-team__intro cesar-sec--align-{{ section.settings.text_alignment }}" {% render 'cesar-motion', s: section.settings %}>
        {%- if section.settings.caption != blank -%}
          <p class="cesar-team__caption">{{ section.settings.caption }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="cesar-team__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="cesar-team__text rte">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="cesar-team__grid cesar-team__grid--{{ section.settings.ratio }}{% if section.settings.card_bg != blank %} cesar-team__grid--boxed{% endif %}" role="list">
        {%- for block in section.blocks -%}
          <li class="cesar-team__member" {{ block.shopify_attributes }} {% render 'cesar-motion', s: section.settings, i: forloop.index0 %}>
            <div class="cesar-team__media">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 1000
                  | image_tag:
                    loading: 'lazy',
                    sizes: '(min-width: 990px) 33vw, 90vw',
                    widths: '300, 500, 700, 1000',
                    class: 'cesar-team__photo',
                    alt: block.settings.image.alt | default: block.settings.name
                }}
              {%- else -%}
                {%- comment -%}
                  Sin retrato, las iniciales: es mejor que un hueco y hace que
                  la card siga teniendo la altura de las demás.
                {%- endcomment -%}
                <div class="cesar-team__photo cesar-team__photo--empty" aria-hidden="true">
                  {{ block.settings.name | truncate: 1, '' }}
                </div>
              {%- endif -%}
            </div>

            <div class="cesar-team__body">
              {%- if block.settings.name != blank -%}
                <h3 class="cesar-team__name">{{ block.settings.name }}</h3>
              {%- endif -%}

              {%- if block.settings.role != blank -%}
                <p class="cesar-team__role">{{ block.settings.role }}</p>
              {%- endif -%}

              {%- if block.settings.bio != blank -%}
                <div class="cesar-team__bio rte">{{ block.settings.bio }}</div>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Cesar · Equipo",
  "tag": "section",
  "class": "cesar-team-section",
  "settings": [
    { "type": "text", "id": "caption", "label": "Antetítulo" },
    { "type": "text", "id": "heading", "label": "Titular", "default": "The team" },
    { "type": "richtext", "id": "text", "label": "Texto" },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Alineación del encabezado",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "left"
    },
    { "type": "header", "content": "Retratos" },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columnas en escritorio",
      "default": 2
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Proporción del retrato",
      "options": [
        { "value": "portrait", "label": "Vertical (4:5)" },
        { "value": "square", "label": "Cuadrado" },
        { "value": "landscape", "label": "Apaisado (4:3)" }
      ],
      "default": "portrait"
    },
    { "type": "header", "content": "Ancho" },
    { "type": "checkbox", "id": "limit_width", "label": "Limitar el ancho del contenido", "default": true },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 2000,
      "step": 20,
      "unit": "px",
      "label": "Ancho máximo",
      "default": 1200
    },
    { "type": "header", "content": "Colores y tamaños" },
    {
      "type": "paragraph",
      "content": "Todos opcionales. Vacíos o en 0, la sección usa su esquema de color y la escala tipográfica del tema."
    },
    { "type": "color", "id": "bg_color", "label": "Fondo de la sección" },
    { "type": "color", "id": "heading_color", "label": "Titular y nombres" },
    { "type": "color", "id": "text_color", "label": "Texto" },
    { "type": "color", "id": "role_color", "label": "Cargo" },
    { "type": "color", "id": "card_bg", "label": "Fondo de cada persona", "info": "Vacío, sin caja: retrato y texto directamente sobre la sección." },
    {
      "type": "range",
      "id": "heading_px",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Tamaño del titular",
      "default": 0,
      "info": "0 = el del tema."
    },
    {
      "type": "range",
      "id": "name_px",
      "min": 0,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "Tamaño del nombre",
      "default": 0,
      "info": "0 = el del tema."
    },
    {
      "type": "range",
      "id": "text_px",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Tamaño del texto",
      "default": 0,
      "info": "0 = el del tema."
    },
    {
      "type": "header",
      "content": "Animación"
    },
    {
      "type": "select",
      "id": "motion_reveal",
      "label": "Entrada al hacer scroll",
      "options": [
        {
          "value": "none",
          "label": "Sin animación"
        },
        {
          "value": "fade-up",
          "label": "Aparece subiendo"
        },
        {
          "value": "fade",
          "label": "Aparece"
        },
        {
          "value": "zoom",
          "label": "Aparece creciendo"
        },
        {
          "value": "slide",
          "label": "Entra desde la izquierda"
        }
      ],
      "default": "fade-up"
    },
    {
      "type": "checkbox",
      "id": "motion_stagger",
      "label": "Escalonar los elementos",
      "default": true,
      "info": "Cada elemento entra un poco después del anterior."
    },
    {
      "type": "paragraph",
      "content": "Si el sistema pide menos movimiento, no hay animación ni parallax: se ve todo quieto desde el principio."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "member",
      "name": "Persona",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Retrato" },
        { "type": "text", "id": "name", "label": "Nombre", "default": "Cesar Mendieta" },
        { "type": "text", "id": "role", "label": "Cargo", "default": "Founder" },
        {
          "type": "richtext",
          "id": "bio",
          "label": "Texto",
          "default": "<p>Founded the business on his family's coffee-growing heritage in Colombia.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cesar · Equipo",
      "blocks": [{ "type": "member" }, { "type": "member" }]
    }
  ]
}
{% endschema %}
