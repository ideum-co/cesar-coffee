{{ 'cesar-feature-cards.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cesar-feature-cards.js' | asset_url }}" defer="defer"></script>

{%- comment -%}
  Fila de tarjetas con foto a sangre, rótulo encima y un panel flotante abajo.

  Las tarjetas tienen ancho fijo y la fila se desplaza: al reducir la ventana no
  se estrechan ni se reparten, se ve una menos y asoma la siguiente. Es lo que
  se pidió para los carruseles del tema, y además es lo que hace entender que
  hay más contenido a la derecha sin necesidad de leer nada.
{%- endcomment -%}

{%- capture cesar_style -%}
  {% render 'cesar-section-style', s: section.settings %}
  {% if section.settings.limit_width %}--cesar-fc-max: {{ section.settings.max_width }}px;{% endif %}
  --cesar-fc-card-width: {{ section.settings.card_width }}px;
  --cesar-fc-card-height: {{ section.settings.card_height }}px;
  {% if section.settings.custom_radius %}--cesar-fc-radius: {{ section.settings.card_radius }}px;{% endif %}
  {% if section.settings.caption_color != blank %}--cesar-fc-caption: {{ section.settings.caption_color }};{% endif %}
  {% if section.settings.card_title_color != blank %}--cesar-fc-card-title: {{ section.settings.card_title_color }};{% endif %}
  {% if section.settings.card_title_px > 0 %}--cesar-fc-card-title-size: {{ section.settings.card_title_px }}px;{% endif %}
  {% if section.settings.panel_bg != blank %}--cesar-fc-panel-bg: {{ section.settings.panel_bg }};{% endif %}
  {% if section.settings.panel_text != blank %}--cesar-fc-panel-text: {{ section.settings.panel_text }};{% endif %}
  {% if section.settings.panel_px > 0 %}--cesar-fc-panel-size: {{ section.settings.panel_px }}px;{% endif %}
  {% if section.settings.icon_bg != blank %}--cesar-fc-icon-bg: {{ section.settings.icon_bg }};{% endif %}
  {% if section.settings.scrim_opacity > 0 %}--cesar-fc-scrim: {{ section.settings.scrim_opacity | divided_by: 100.0 }};{% endif %}
{%- endcapture -%}

<div
  class="cesar-fc cesar-sec cc-section color-{{ section.settings.color_scheme }}"
  {% if cesar_style != blank %}style="{{ cesar_style | strip_newlines | strip }}"{% endif %}
>
  <div class="cesar-fc__container cc-container{% if section.settings.limit_width %} cesar-fc__container--limited{% endif %}">
    {%- if section.settings.caption != blank or section.settings.heading != blank -%}
      <div class="cesar-fc__intro cesar-sec--align-{{ section.settings.text_alignment }}" {% render 'cesar-motion', s: section.settings %}>
        {%- if section.settings.caption != blank -%}
          <p class="cesar-fc__caption">{{ section.settings.caption }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="cesar-fc__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="cesar-fc__text rte">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  {%- if section.blocks.size > 0 -%}
    <cesar-feature-cards class="cesar-fc__rail-wrap" {% render 'cesar-motion', s: section.settings %}>
      {%- comment -%}
        La fila se desplaza con el teclado además de con las flechas, así que
        lleva tabindex y se anuncia como región con nombre: si no, quien navega
        con teclado no puede llegar a las tarjetas que quedan fuera de vista.
      {%- endcomment -%}
      <ul
        class="cesar-fc__rail{% if section.settings.limit_width %} cesar-fc__rail--limited{% endif %}"
        role="region"
        tabindex="0"
        aria-label="{{ section.settings.heading | default: 'Cards' | escape }}"
        data-fc-rail
      >
        {%- for block in section.blocks -%}
          {%- liquid
            assign icono = block.settings.icon
            assign icono_src = ''
            if icono.url != blank
              assign icono_src = icono.url
            elsif icono != blank
              assign icono_src = icono | image_url: width: 96
            endif
          -%}
          <li class="cesar-fc__item" {{ block.shopify_attributes }}>
            <div class="cesar-fc__card">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'lazy',
                    sizes: '(min-width: 750px) 420px, 80vw',
                    widths: '300, 500, 700, 900, 1200',
                    class: 'cesar-fc__image',
                    alt: block.settings.image.alt
                }}
              {%- else -%}
                <div class="cesar-fc__image cesar-fc__image--empty"></div>
              {%- endif -%}

              {%- comment -%}
                Velo degradado bajo el rótulo. No es adorno: en blanco sobre una
                foto cualquiera el título no llega al contraste mínimo.
              {%- endcomment -%}
              <div class="cesar-fc__scrim"></div>

              {%- if block.settings.title != blank -%}
                <h3 class="cesar-fc__card-title">{{ block.settings.title }}</h3>
              {%- endif -%}

              {%- if block.settings.text != blank or block.settings.link_label != blank -%}
                <div class="cesar-fc__panel">
                  {%- if icono_src != blank -%}
                    <span class="cesar-fc__icon">
                      <img src="{{ icono_src }}" alt="" loading="lazy" width="20" height="20">
                    </span>
                  {%- endif -%}

                  <div class="cesar-fc__panel-body">
                    {%- if block.settings.text != blank -%}
                      <p class="cesar-fc__panel-text">{{ block.settings.text }}</p>
                    {%- endif -%}

                    {%- if block.settings.link_label != blank -%}
                      {%- comment -%}
                        El rótulo de la card se añade oculto al final del
                        enlace: en una lista de enlaces se lee "Cajitas y CDT —
                        Inteligente" y no cuatro veces el mismo texto suelto.
                      {%- endcomment -%}
                      <a href="{{ block.settings.link | default: '#' }}" class="cesar-fc__link">
                        {{ block.settings.link_label }}
                        {%- if block.settings.title != blank -%}
                          <span class="visually-hidden"> — {{ block.settings.title }}</span>
                        {%- endif -%}
                      </a>
                    {%- endif -%}
                  </div>
                </div>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>

      {%- comment -%}
        Las flechas se ocultan solas cuando todas las tarjetas caben, que es
        cuando no llevan a ninguna parte.
      {%- endcomment -%}
      <div class="cesar-fc__nav" data-fc-nav hidden>
        <button
          type="button"
          class="cesar-fc__arrow"
          data-fc-prev
          aria-label="{{ 'general.slider.previous_slide' | t }}"
        >
          <span class="cesar-fc__arrow-icon" aria-hidden="true">←</span>
        </button>
        <button
          type="button"
          class="cesar-fc__arrow"
          data-fc-next
          aria-label="{{ 'general.slider.next_slide' | t }}"
        >
          <span class="cesar-fc__arrow-icon" aria-hidden="true">→</span>
        </button>
      </div>
    </cesar-feature-cards>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Cesar · Cards en fila",
  "tag": "section",
  "class": "cesar-feature-cards-section",
  "settings": [
    {
      "type": "text",
      "id": "caption",
      "label": "Antetítulo"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titular",
      "default": "What you get"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Alineación del encabezado",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Tarjetas"
    },
    {
      "type": "paragraph",
      "content": "Las tarjetas mantienen su tamaño: si no caben todas, la fila se desplaza y asoma la siguiente en lugar de estrecharlas."
    },
    {
      "type": "range",
      "id": "card_width",
      "min": 240,
      "max": 520,
      "step": 10,
      "unit": "px",
      "label": "Ancho",
      "default": 390
    },
    {
      "type": "range",
      "id": "card_height",
      "min": 300,
      "max": 640,
      "step": 10,
      "unit": "px",
      "label": "Alto",
      "default": 430
    },
    {
      "type": "checkbox",
      "id": "custom_radius",
      "label": "Redondeo propio",
      "default": false
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Redondeo",
      "default": 22
    },
    {
      "type": "range",
      "id": "scrim_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Velo sobre la foto",
      "default": 45,
      "info": "Oscurece la parte superior para que el rótulo se lea. Bajarlo mucho puede dejar el título por debajo del contraste mínimo."
    },
    {
      "type": "header",
      "content": "Ancho"
    },
    {
      "type": "checkbox",
      "id": "limit_width",
      "label": "Limitar el ancho del contenido",
      "default": true
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 2000,
      "step": 20,
      "unit": "px",
      "label": "Ancho máximo",
      "default": 1400
    },
    {
      "type": "header",
      "content": "Colores y tamaños"
    },
    {
      "type": "paragraph",
      "content": "Todos opcionales. Vacíos o en 0, la sección usa su esquema de color y la escala tipográfica del tema."
    },
    { "type": "color", "id": "bg_color", "label": "Fondo de la sección" },
    { "type": "color", "id": "caption_color", "label": "Antetítulo" },
    { "type": "color", "id": "heading_color", "label": "Titular" },
    { "type": "color", "id": "text_color", "label": "Texto" },
    { "type": "color", "id": "card_title_color", "label": "Rótulo sobre la foto" },
    { "type": "color", "id": "panel_bg", "label": "Fondo del panel" },
    { "type": "color", "id": "panel_text", "label": "Texto del panel" },
    { "type": "color", "id": "icon_bg", "label": "Fondo del icono" },
    { "type": "color", "id": "link_color", "label": "Enlaces" },
    { "type": "color", "id": "link_hover_color", "label": "Enlaces al pasar por encima" },
    {
      "type": "range",
      "id": "heading_px",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Tamaño del titular",
      "default": 0,
      "info": "0 = el del tema."
    },
    {
      "type": "range",
      "id": "card_title_px",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Tamaño del rótulo",
      "default": 0,
      "info": "0 = el del tema."
    },
    {
      "type": "range",
      "id": "panel_px",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Tamaño del texto del panel",
      "default": 0,
      "info": "0 = el del tema."
    },
    {
      "type": "range",
      "id": "text_px",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Tamaño del texto de entrada",
      "default": 0,
      "info": "0 = el del tema."
    },
    {
      "type": "header",
      "content": "Animación"
    },
    {
      "type": "select",
      "id": "motion_reveal",
      "label": "Entrada al hacer scroll",
      "options": [
        {
          "value": "none",
          "label": "Sin animación"
        },
        {
          "value": "fade-up",
          "label": "Aparece subiendo"
        },
        {
          "value": "fade",
          "label": "Aparece"
        },
        {
          "value": "zoom",
          "label": "Aparece creciendo"
        },
        {
          "value": "slide",
          "label": "Entra desde la izquierda"
        }
      ],
      "default": "fade-up"
    },
    {
      "type": "paragraph",
      "content": "Si el sistema pide menos movimiento, no hay animación ni parallax: se ve todo quieto desde el principio."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Foto" },
        { "type": "text", "id": "title", "label": "Rótulo", "default": "Fast" },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icono",
          "info": "Opcional, dentro del círculo del panel. Un SVG de una sola tinta funciona mejor."
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texto del panel",
          "default": "Roasted to order and dispatched within days"
        },
        { "type": "text", "id": "link_label", "label": "Enlace" },
        { "type": "url", "id": "link", "label": "Destino del enlace" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cesar · Cards en fila",
      "blocks": [{ "type": "card" }, { "type": "card" }, { "type": "card" }, { "type": "card" }]
    }
  ]
}
{% endschema %}
