{{ 'cesar-steps.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Pasos numerados de un servicio. Pensada para páginas de aterrizaje, donde lo
  que hay que explicar no es un producto sino cómo funciona algo.

  La numeración la lleva el CSS con un contador, no el texto de cada bloque: al
  reordenar o borrar pasos en el personalizador se renumera sola, que es
  justamente donde se cuelan los errores si el número va escrito a mano.
{%- endcomment -%}

{%- capture cesar_style -%}
  {% render 'cesar-section-style', s: section.settings %}
  {% if section.settings.limit_width %}--cesar-steps-max: {{ section.settings.max_width }}px;{% endif %}
  {% if section.settings.number_color != blank %}--cesar-steps-number: {{ section.settings.number_color }};{% endif %}
  {% if section.settings.number_px > 0 %}--cesar-steps-number-size: {{ section.settings.number_px }}px;{% endif %}
  {% if section.settings.step_title_px > 0 %}--cesar-steps-title-size: {{ section.settings.step_title_px }}px;{% endif %}
  {% if section.settings.rule_color != blank %}--cesar-steps-rule: {{ section.settings.rule_color }};{% endif %}
{%- endcapture -%}

<div
  class="cesar-steps cesar-sec cc-section color-{{ section.settings.color_scheme }}"
  {% if cesar_style != blank %}style="{{ cesar_style | strip_newlines | strip }}"{% endif %}
>
  <div class="cesar-steps__container cc-container{% if section.settings.limit_width %} cesar-steps__container--limited{% endif %}">
    {%- if section.settings.heading != blank or section.settings.text != blank -%}
      <div class="cesar-steps__intro cesar-sec--align-{{ section.settings.text_alignment }}" {% render 'cesar-motion', s: section.settings %}>
        {%- if section.settings.caption != blank -%}
          <p class="cesar-steps__caption">{{ section.settings.caption }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="cesar-steps__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="cesar-steps__text rte">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      {%- comment -%}
        Lista ordenada y no una serie de divs: el orden es parte del contenido,
        y así se anuncia como "paso 2 de 4" sin depender de lo que se ve.
      {%- endcomment -%}
      <ol class="cesar-steps__list cesar-steps__list--{{ section.settings.layout }}">
        {%- for block in section.blocks -%}
          <li class="cesar-steps__item" {{ block.shopify_attributes }} {% render 'cesar-motion', s: section.settings, i: forloop.index0 %}>
            {%- if block.settings.image != blank -%}
              <div class="cesar-steps__media">
                {{
                  block.settings.image
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    sizes: '(min-width: 990px) 33vw, 90vw',
                    widths: '300, 500, 700, 900',
                    class: 'cesar-steps__image',
                    alt: block.settings.image.alt
                }}
              </div>
            {%- endif -%}

            <div class="cesar-steps__body">
              {%- if block.settings.title != blank -%}
                <h3 class="cesar-steps__title">{{ block.settings.title }}</h3>
              {%- endif -%}

              {%- if block.settings.text != blank -%}
                <div class="cesar-steps__step-text rte">{{ block.settings.text }}</div>
              {%- endif -%}

              {%- if block.settings.link_label != blank -%}
                <a href="{{ block.settings.link | default: '#' }}" class="cesar-steps__link">
                  {{ block.settings.link_label }}
                </a>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="cesar-steps__actions cesar-sec--align-{{ section.settings.text_alignment }}" {% render 'cesar-motion', s: section.settings %}>
        <a href="{{ section.settings.button_link | default: '#' }}" class="cesar-steps__button">
          {{ section.settings.button_label }}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Cesar · Pasos",
  "tag": "section",
  "class": "cesar-steps-section",
  "settings": [
    {
      "type": "text",
      "id": "caption",
      "label": "Antetítulo",
      "default": "How it works"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titular",
      "default": "Bring your green. We do the rest."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Disposición",
      "options": [
        { "value": "row", "label": "En fila" },
        { "value": "stack", "label": "Uno debajo de otro" }
      ],
      "default": "row",
      "info": "En fila funciona con tres o cuatro pasos cortos. Uno debajo de otro deja sitio para explicar cada paso con calma."
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Alineación del encabezado",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Botón bajo los pasos"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del botón"
    },
    {
      "type": "header",
      "content": "Ancho"
    },
    {
      "type": "checkbox",
      "id": "limit_width",
      "label": "Limitar el ancho del contenido",
      "default": true
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 2000,
      "step": 20,
      "unit": "px",
      "label": "Ancho máximo",
      "default": 1400
    },
    {
      "type": "header",
      "content": "Colores y tamaños"
    },
    {
      "type": "paragraph",
      "content": "Todos opcionales. Vacíos o en 0, la sección usa su esquema de color y la escala tipográfica del tema. Al cambiarlos comprueba que el texto siga leyéndose sobre el fondo."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Fondo de la sección"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Titular"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Texto"
    },
    {
      "type": "color",
      "id": "number_color",
      "label": "Número del paso"
    },
    {
      "type": "color",
      "id": "rule_color",
      "label": "Línea separadora"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Enlaces"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Fondo del botón"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Texto del botón"
    },
    {
      "type": "range",
      "id": "heading_px",
      "min": 0,
      "max": 140,
      "step": 2,
      "unit": "px",
      "label": "Tamaño del titular",
      "default": 0,
      "info": "0 = el del tema."
    },
    {
      "type": "range",
      "id": "number_px",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Tamaño del número",
      "default": 0,
      "info": "0 = el del tema."
    },
    {
      "type": "range",
      "id": "step_title_px",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Tamaño del título del paso",
      "default": 0,
      "info": "0 = el del tema."
    },
    {
      "type": "range",
      "id": "text_px",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Tamaño del texto",
      "default": 0,
      "info": "0 = el del tema."
    },
    {
      "type": "header",
      "content": "Animación"
    },
    {
      "type": "select",
      "id": "motion_reveal",
      "label": "Entrada al hacer scroll",
      "options": [
        {
          "value": "none",
          "label": "Sin animación"
        },
        {
          "value": "fade-up",
          "label": "Aparece subiendo"
        },
        {
          "value": "fade",
          "label": "Aparece"
        },
        {
          "value": "zoom",
          "label": "Aparece creciendo"
        },
        {
          "value": "slide",
          "label": "Entra desde la izquierda"
        }
      ],
      "default": "fade-up"
    },
    {
      "type": "checkbox",
      "id": "motion_stagger",
      "label": "Escalonar los elementos",
      "default": true,
      "info": "Cada elemento entra un poco después del anterior."
    },
    {
      "type": "paragraph",
      "content": "Si el sistema pide menos movimiento, no hay animación ni parallax: se ve todo quieto desde el principio."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Paso",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Send us your green"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Texto",
          "default": "<p>Tell us the lot, the volume and the profile you are after.</p>"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen",
          "info": "Opcional. Sin ella el paso queda sólo con su número y su texto."
        },
        { "type": "text", "id": "link_label", "label": "Enlace" },
        { "type": "url", "id": "link", "label": "Destino del enlace" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cesar · Pasos",
      "blocks": [{ "type": "step" }, { "type": "step" }, { "type": "step" }]
    }
  ]
}
{% endschema %}
