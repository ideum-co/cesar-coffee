{{ 'cesar-hero.css' | asset_url | stylesheet_tag }}

<div class="cesar-hero color-{{ section.settings.color_scheme }}">
  <div class="cesar-hero__inner cc-container">
    <div class="cesar-hero__content">
      {%- if section.settings.heading != blank -%}
        <h1 class="cc-display cesar-hero__heading">{{ section.settings.heading }}</h1>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="cesar-hero__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}

      {%- if section.settings.button_label != blank or section.settings.button_label_2 != blank -%}
        <div class="cesar-hero__actions">
          {%- if section.settings.button_label != blank -%}
            <a
              href="{{ section.settings.button_link | default: '#' }}"
              class="cc-btn cc-btn--primary"
            >
              {{ section.settings.button_label }}
            </a>
          {%- endif -%}
          {%- if section.settings.button_label_2 != blank -%}
            <a
              href="{{ section.settings.button_link_2 | default: '#' }}"
              class="cc-btn cc-btn--secondary"
            >
              {{ section.settings.button_label_2 }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.image != blank -%}
      <div class="cesar-hero__media">
        {{
          section.settings.image
          | image_url: width: 1600
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            sizes: '(min-width: 990px) 50vw, 100vw',
            widths: '400, 600, 800, 1000, 1200, 1600',
            class: 'cesar-hero__image',
            alt: section.settings.image.alt
        }}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Cesar · Hero",
  "tag": "section",
  "class": "cesar-hero-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titular",
      "default": "Strong roots. Direct from origin."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subtítulo",
      "default": "Colombian coffee, sourced direct from origin and roasted to order in Melbourne."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen",
      "info": "PNG con fondo transparente (granos de café) para el efecto flotante del diseño."
    },
    {
      "type": "header",
      "content": "Botones"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Botón principal",
      "default": "Shop The Range"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del botón principal"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Botón secundario",
      "default": "Our Story"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Enlace del botón secundario"
    },
    {
      "type": "header",
      "content": "Estilo"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Cesar · Hero"
    }
  ]
}
{% endschema %}
