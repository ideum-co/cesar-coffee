{{ 'cesar-link-list.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Va a sangre, sin .cc-container: las dos mitades llegan a los bordes y la
  imagen ocupa su 50% completo.
{%- endcomment -%}
{%- capture list_style -%}
  {% if section.settings.bg_color != blank %}--cesar-sec-bg: {{ section.settings.bg_color }};{% endif %}
  {% if section.settings.heading_color != blank %}--cesar-sec-heading: {{ section.settings.heading_color }};{% endif %}
  {% if section.settings.link_color != blank %}--cesar-sec-link: {{ section.settings.link_color }};{% endif %}
  {% if section.settings.link_hover_color != blank %}--cesar-sec-link-hover: {{ section.settings.link_hover_color }};{% endif %}
{%- endcapture -%}
<div
  class="cesar-link-list cesar-link-list--image-{{ section.settings.image_position }} cesar-sec cesar-sec--align-{{ section.settings.text_alignment }} color-{{ section.settings.color_scheme }}"
  {% if list_style != blank %}style="{{ list_style | strip_newlines | strip }}"{% endif %}
>
  <div class="cesar-link-list__inner">
    <div class="cesar-link-list__links">
      {%- if section.settings.heading != blank -%}
        <h2 class="cesar-link-list__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      <ul class="cesar-link-list__items" role="list">
        {%- for block in section.blocks -%}
          <li class="cesar-link-list__item" {{ block.shopify_attributes }}>
            <a href="{{ block.settings.link | default: '#' }}" class="cesar-link-list__link">
              {{- block.settings.label -}}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </div>

    {%- if section.settings.image != blank -%}
      <div class="cesar-link-list__media">
        {{
          section.settings.image
          | image_url: width: 2000
          | image_tag:
            loading: 'lazy',
            sizes: '(min-width: 990px) 50vw, 100vw',
            widths: '400, 600, 800, 1200, 1600, 2000',
            class: 'cesar-link-list__image',
            alt: section.settings.image.alt
        }}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Cesar · Lista destacada",
  "tag": "section",
  "class": "cesar-link-list-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titular (opcional)"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Posición de la imagen",
      "options": [
        {
          "value": "left",
          "label": "Izquierda"
        },
        {
          "value": "right",
          "label": "Derecha"
        }
      ],
      "default": "right"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Alineación del texto",
      "options": [
        {
          "value": "left",
          "label": "Izquierda"
        },
        {
          "value": "center",
          "label": "Centro"
        },
        {
          "value": "right",
          "label": "Derecha"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Colores"
    },
    {
      "type": "paragraph",
      "content": "Todos opcionales. Vacíos, la sección usa su esquema de color. Al cambiarlos comprueba que el texto siga leyéndose sobre el fondo."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Fondo de la sección"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Titular"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Enlaces"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Enlaces al pasar el ratón"
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Enlace",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Texto",
          "default": "Green"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cesar · Lista destacada",
      "blocks": [
        {
          "type": "link",
          "settings": {
            "label": "Green"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "Silver"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "Gold"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "The Flight"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "Subscriptions"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "Wholesale"
          }
        }
      ]
    }
  ]
}
{% endschema %}
