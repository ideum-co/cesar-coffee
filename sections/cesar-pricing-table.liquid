{{ 'cesar-pricing-table.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Tabla de precios por paquete.

  Va en una <table> de verdad y no en una rejilla de divs: son datos tabulares,
  y con encabezados de columna y de fila quien usa un lector de pantalla oye
  "Standard, precio por kg, 24,13" en vez de una lista de números sueltos.
{%- endcomment -%}

{%- capture cesar_style -%}
  {% render 'cesar-section-style', s: section.settings %}
  {% if section.settings.limit_width %}--cesar-pt-max: {{ section.settings.max_width }}px;{% endif %}
  {% if section.settings.head_bg != blank %}--cesar-pt-head-bg: {{ section.settings.head_bg }};{% endif %}
  {% if section.settings.head_text != blank %}--cesar-pt-head-text: {{ section.settings.head_text }};{% endif %}
  {% if section.settings.rule_color != blank %}--cesar-pt-rule: {{ section.settings.rule_color }};{% endif %}
  {% if section.settings.highlight_bg != blank %}--cesar-pt-highlight: {{ section.settings.highlight_bg }};{% endif %}
  {% if section.settings.price_px > 0 %}--cesar-pt-price-size: {{ section.settings.price_px }}px;{% endif %}
{%- endcapture -%}

<div
  class="cesar-pt cesar-sec cc-section color-{{ section.settings.color_scheme }}"
  {% if cesar_style != blank %}style="{{ cesar_style | strip_newlines | strip }}"{% endif %}
>
  <div class="cesar-pt__container cc-container{% if section.settings.limit_width %} cesar-pt__container--limited{% endif %}">
    {%- if section.settings.heading != blank or section.settings.text != blank -%}
      <div class="cesar-pt__intro cesar-sec--align-{{ section.settings.text_alignment }}" {% render 'cesar-motion', s: section.settings, i: 0 %}>
        {%- if section.settings.heading != blank -%}
          <h2 class="cesar-pt__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="cesar-pt__text rte">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      {%- comment -%}
        La caja puede desplazarse si la tabla no cabe. Lleva tabindex para que
        quien navega con teclado pueda desplazarla, y el rol y el nombre para
        que se anuncie como una región y no como un cajón sin identificar.
      {%- endcomment -%}
      <div
        class="cesar-pt__scroll"
        {% render 'cesar-motion', s: section.settings, i: 1 %}
        tabindex="0"
        role="region"
        aria-label="{{ section.settings.heading | default: 'Pricing' | escape }}"
      >
        <table class="cesar-pt__table">
          <thead>
            <tr>
              <th scope="col">{{ section.settings.col_1_label }}</th>
              <th scope="col">{{ section.settings.col_2_label }}</th>
              <th scope="col" class="cesar-pt__col-price">{{ section.settings.col_3_label }}</th>
            </tr>
          </thead>
          <tbody>
            {%- for block in section.blocks -%}
              <tr
                class="cesar-pt__row{% if block.settings.highlight %} cesar-pt__row--highlight{% endif %}"
                {{ block.shopify_attributes }}
              >
                {%- comment -%}
                  El nombre del paquete encabeza su fila: es lo que identifica
                  cada celda de esa línea.
                {%- endcomment -%}
                <th scope="row" class="cesar-pt__package">
                  {{ block.settings.package }}
                  {%- if block.settings.badge != blank -%}
                    <span class="cesar-pt__badge">{{ block.settings.badge }}</span>
                  {%- endif -%}
                </th>
                <td>{{ block.settings.length }}</td>
                <td class="cesar-pt__price">{{ block.settings.price }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>
    {%- endif -%}

    {%- if section.settings.note != blank -%}
      <div class="cesar-pt__note rte">{{ section.settings.note }}</div>
    {%- endif -%}

    {%- if section.settings.included_heading != blank or section.settings.included_text != blank -%}
      <div class="cesar-pt__included" {% render 'cesar-motion', s: section.settings, i: 2 %}>
        {%- if section.settings.included_heading != blank -%}
          <h3 class="cesar-pt__included-heading">{{ section.settings.included_heading }}</h3>
        {%- endif -%}

        {%- if section.settings.included_text != blank -%}
          <div class="cesar-pt__included-text rte">{{ section.settings.included_text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="cesar-pt__actions cesar-sec--align-{{ section.settings.text_alignment }}" {% render 'cesar-motion', s: section.settings, i: 3 %}>
        <a href="{{ section.settings.button_link | default: '#' }}" class="cesar-pt__button">
          {{ section.settings.button_label }}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Cesar · Tabla de precios",
  "tag": "section",
  "class": "cesar-pricing-table-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titular",
      "default": "Pricing"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Alineación del encabezado",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Columnas"
    },
    {
      "type": "text",
      "id": "col_1_label",
      "label": "Columna 1",
      "default": "Package"
    },
    {
      "type": "text",
      "id": "col_2_label",
      "label": "Columna 2",
      "default": "Session length"
    },
    {
      "type": "text",
      "id": "col_3_label",
      "label": "Columna 3",
      "default": "Price per kg"
    },
    {
      "type": "richtext",
      "id": "note",
      "label": "Nota bajo la tabla"
    },
    {
      "type": "header",
      "content": "Qué incluye"
    },
    {
      "type": "text",
      "id": "included_heading",
      "label": "Titular"
    },
    {
      "type": "richtext",
      "id": "included_text",
      "label": "Texto"
    },
    {
      "type": "header",
      "content": "Botón"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del botón"
    },
    {
      "type": "header",
      "content": "Ancho"
    },
    {
      "type": "checkbox",
      "id": "limit_width",
      "label": "Limitar el ancho del contenido",
      "default": true
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 700,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "label": "Ancho máximo",
      "default": 1100
    },
    {
      "type": "header",
      "content": "Colores y tamaños"
    },
    {
      "type": "paragraph",
      "content": "Todos opcionales. Vacíos o en 0, la sección usa su esquema de color y la escala tipográfica del tema."
    },
    { "type": "color", "id": "bg_color", "label": "Fondo de la sección" },
    { "type": "color", "id": "heading_color", "label": "Titular" },
    { "type": "color", "id": "text_color", "label": "Texto" },
    { "type": "color", "id": "head_bg", "label": "Fondo de la cabecera" },
    { "type": "color", "id": "head_text", "label": "Texto de la cabecera" },
    { "type": "color", "id": "rule_color", "label": "Líneas de la tabla" },
    { "type": "color", "id": "highlight_bg", "label": "Fondo de la fila destacada" },
    { "type": "color", "id": "button_bg", "label": "Fondo del botón" },
    { "type": "color", "id": "button_text", "label": "Texto del botón" },
    {
      "type": "range",
      "id": "heading_px",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Tamaño del titular",
      "default": 0,
      "info": "0 = el del tema."
    },
    {
      "type": "range",
      "id": "text_px",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Tamaño del texto",
      "default": 0,
      "info": "0 = el del tema."
    },
    {
      "type": "range",
      "id": "price_px",
      "min": 0,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "Tamaño del precio",
      "default": 0,
      "info": "0 = el del tema."
    },
    {
      "type": "header",
      "content": "Animación"
    },
    {
      "type": "select",
      "id": "motion_reveal",
      "label": "Entrada al hacer scroll",
      "options": [
        {
          "value": "none",
          "label": "Sin animación"
        },
        {
          "value": "fade-up",
          "label": "Aparece subiendo"
        },
        {
          "value": "fade",
          "label": "Aparece"
        },
        {
          "value": "zoom",
          "label": "Aparece creciendo"
        },
        {
          "value": "slide",
          "label": "Entra desde la izquierda"
        }
      ],
      "default": "fade-up"
    },
    {
      "type": "paragraph",
      "content": "Si el sistema pide menos movimiento, no hay animación ni parallax: se ve todo quieto desde el principio."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Fila",
      "settings": [
        { "type": "text", "id": "package", "label": "Paquete", "default": "Starter" },
        { "type": "text", "id": "length", "label": "Duración", "default": "1 hour" },
        { "type": "text", "id": "price", "label": "Precio", "default": "$26.00/kg" },
        {
          "type": "text",
          "id": "badge",
          "label": "Etiqueta",
          "info": "Opcional, junto al nombre del paquete. Por ejemplo: Most popular."
        },
        { "type": "checkbox", "id": "highlight", "label": "Destacar la fila", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cesar · Tabla de precios",
      "blocks": [{ "type": "row" }, { "type": "row" }, { "type": "row" }]
    }
  ]
}
{% endschema %}
