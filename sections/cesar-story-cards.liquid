{{ 'cesar-story-cards.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cesar-story-cards.js' | asset_url }}" defer="defer"></script>
<cesar-story-cards class="cesar-story" data-more="{{ section.settings.more_label | escape }}" data-less="{{ section.settings.less_label | escape }}" style="--story-bg:{{ section.settings.bg }};--story-card:{{ section.settings.card_bg }};--story-text:{{ section.settings.text_color }};--story-title:{{ section.settings.title_color }};--story-link:{{ section.settings.link_color }};--story-width:{% if section.settings.limit_width %}{{ section.settings.max_width }}px{% else %}none{% endif %};--story-padding:{{ section.settings.padding }}px;--story-radius:{{ section.settings.radius }}px;--story-icon:{{ section.settings.icon_size }}px;--story-heading-size:{{ section.settings.heading_size }}px;--story-title-size:{{ section.settings.title_size }}px;--story-body-size:{{ section.settings.text_size }}px;--story-align:{{ section.settings.alignment }};">
  <div class="cesar-story__container">
    {% if section.settings.heading != blank %}<h2 class="cesar-story__heading">{{ section.settings.heading | escape }}</h2>{% endif %}
    <div class="cesar-story__track">
      {% for block in section.blocks %}
        {% assign active_index = section.settings.active_card | at_most: section.blocks.size %}
        <article class="cesar-story__card{% if forloop.index == active_index %} is-open{% endif %}" data-story-card {{ block.shopify_attributes }}>
          {% if block.settings.icon != blank %}{{ block.settings.icon | image_url: width: 240 | image_tag: class: 'cesar-story__icon', loading: 'lazy', alt: '' }}{% endif %}
          <h3 class="cesar-story__title">{{ block.settings.title | escape }}</h3>
          <div id="Story-{{ section.id }}-{{ block.id }}" class="cesar-story__body rte">{{ block.settings.text }}</div>
          <button class="cesar-story__toggle" type="button" data-story-toggle aria-controls="Story-{{ section.id }}-{{ block.id }}" aria-expanded="{% if forloop.index == active_index %}true{% else %}false{% endif %}">
            <span data-story-label>{% if forloop.index == active_index %}{{ section.settings.less_label | escape }}{% else %}{{ section.settings.more_label | escape }}{% endif %}</span><span aria-hidden="true">+</span>
          </button>
        </article>
      {% endfor %}
    </div>
  </div>
</cesar-story-cards>
{% schema %}
{
  "name": "Cesar · Coffee stories",
  "enabled_on": { "templates": ["product"] },
  "max_blocks": 8,
  "settings": [
    {"type":"text","id":"heading","label":"Título de sección"},
    {"type":"range","id":"active_card","label":"Card abierta al inicio","min":1,"max":8,"step":1,"default":1},
    {"type":"text","id":"more_label","label":"Texto abrir","default":"See more"},
    {"type":"text","id":"less_label","label":"Texto abierta","default":"Currently reading"},
    {"type":"checkbox","id":"limit_width","label":"Limitar ancho","default":false},
    {"type":"range","id":"max_width","label":"Ancho máximo","min":900,"max":1800,"step":50,"unit":"px","default":1400},
    {"type":"range","id":"padding","label":"Espacio vertical","min":0,"max":120,"step":4,"unit":"px","default":40},
    {"type":"range","id":"radius","label":"Radio de cards","min":0,"max":60,"step":2,"unit":"px","default":32},
    {"type":"range","id":"icon_size","label":"Tamaño icono","min":32,"max":120,"step":4,"unit":"px","default":80},
    {"type":"range","id":"heading_size","label":"Tamaño título sección","min":20,"max":72,"step":2,"unit":"px","default":40},
    {"type":"range","id":"title_size","label":"Tamaño título card","min":16,"max":40,"step":1,"unit":"px","default":24},
    {"type":"range","id":"text_size","label":"Tamaño texto","min":12,"max":24,"step":1,"unit":"px","default":16},
    {"type":"text_alignment","id":"alignment","label":"Alineación título sección","default":"left"},
    {"type":"color","id":"bg","label":"Fondo sección","default":"#EBEBED"},
    {"type":"color","id":"card_bg","label":"Fondo cards","default":"#FFFFFF"},
    {"type":"color","id":"title_color","label":"Color títulos","default":"#4A3120"},
    {"type":"color","id":"text_color","label":"Color texto","default":"#4A3120"},
    {"type":"color","id":"link_color","label":"Color enlace","default":"#4A3120"}
  ],
  "blocks": [{"type":"story","name":"Card","settings":[
    {"type":"image_picker","id":"icon","label":"Icono"},
    {"type":"text","id":"title","label":"Título","default":"Origin & Process"},
    {"type":"richtext","id":"text","label":"Texto","default":"<p>Share the story behind this coffee.</p>"}
  ]}],
  "presets": [{"name":"Cesar · Coffee stories","blocks":[
    {"type":"story","settings":{"title":"Origin & Process"}},
    {"type":"story","settings":{"title":"Tasting Notes"}},
    {"type":"story","settings":{"title":"Roast & Dispatch"}}
  ]}]
}
{% endschema %}
