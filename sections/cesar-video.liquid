{{ 'cesar-video.css' | asset_url | stylesheet_tag }}
{{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Vídeo a todo el ancho con portada y botón de reproducción propio.

  El reproductor no se carga hasta que se pulsa: se apoya en deferred-media,
  que ya viene con el tema (global.js). Así la ficha no arrastra el peso de un
  iframe de YouTube o de un vídeo alojado que quizá nadie llegue a ver.
{%- endcomment -%}

{%- liquid
  assign video_id = section.settings.video.id | default: section.settings.video_url.id
  assign poster = section.settings.video.preview_image | default: section.settings.cover_image
  assign etiqueta = section.settings.play_label | default: 'Play'
  assign alt = section.settings.description | default: etiqueta | escape
-%}

{%- capture cesar_style -%}
  {% render 'cesar-section-style', s: section.settings %}
  {% if section.settings.limit_width %}--cesar-video-max: {{ section.settings.max_width }}px;{% endif %}
  {% if section.settings.play_bg != blank %}--cesar-video-play-bg: {{ section.settings.play_bg }};{% endif %}
  {% if section.settings.play_text != blank %}--cesar-video-play-text: {{ section.settings.play_text }};{% endif %}
  {% if section.settings.play_px > 0 %}--cesar-video-play-size: {{ section.settings.play_px }}px;{% endif %}
{%- endcapture -%}

<div
  class="cesar-video cesar-sec color-{{ section.settings.color_scheme }}"
  {% if cesar_style != blank %}style="{{ cesar_style | strip_newlines | strip }}"{% endif %}
>
  <div class="cesar-video__container{% if section.settings.limit_width %} cesar-video__container--limited{% endif %}">
    {%- if section.settings.heading != blank or section.settings.text != blank -%}
      <div class="cesar-video__intro cesar-sec--align-{{ section.settings.text_alignment }}">
        {%- if section.settings.heading != blank -%}
          <h2 class="cesar-video__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="cesar-video__text rte">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <deferred-media
      class="cesar-video__media deferred-media cesar-video__media--{{ section.settings.ratio }}"
      data-media-id="{{ video_id }}"
    >
      {%- comment -%}
        El id tiene que empezar por 'Deferred-Poster-': deferred-media busca el
        botón con ese prefijo para engancharle el clic. Con cualquier otro
        nombre el reproductor no llegaría a cargarse nunca.
      {%- endcomment -%}
      <button
        id="Deferred-Poster-{{ section.id }}"
        class="cesar-video__poster deferred-media__poster"
        type="button"
        aria-label="{{ alt }}"
      >
        {%- if poster != blank -%}
          {{
            poster
            | image_url: width: 3840
            | image_tag:
              loading: 'lazy',
              sizes: '100vw',
              widths: '750, 1100, 1500, 1780, 2000, 3000, 3840',
              class: 'cesar-video__image',
              alt: alt
          }}
        {%- else -%}
          {{ 'hero-apparel-3' | placeholder_svg_tag: 'cesar-video__image placeholder-svg' }}
        {%- endif -%}

        {%- comment -%}
          El aria-label del botón ya nombra la acción, así que la píldora es
          decorativa para lectores de pantalla y no debe leerse dos veces.
        {%- endcomment -%}
        <span class="cesar-video__play" aria-hidden="true">
          <span class="cesar-video__play-label">{{ etiqueta }}</span>
          <svg class="cesar-video__play-icon" viewBox="0 0 10 12" focusable="false">
            <path d="M0 0.5 9.5 6 0 11.5Z" fill="currentColor" />
          </svg>
        </span>
      </button>

      <template>
        {%- if section.settings.video == null and section.settings.video_url != null -%}
          {%- liquid
            assign loop = ''
            if section.settings.enable_video_looping
              assign loop = '&loop=1&playlist=' | append: video_id
            endif
          -%}
          {%- if section.settings.video_url.type == 'youtube' -%}
            <iframe
              src="https://www.youtube.com/embed/{{ video_id }}?enablejsapi=1&autoplay=1{{ loop }}"
              class="js-youtube"
              allow="autoplay; encrypted-media"
              allowfullscreen
              title="{{ alt }}"
            ></iframe>
          {%- else -%}
            <iframe
              src="https://player.vimeo.com/video/{{ video_id }}?autoplay=1{{ loop }}"
              class="js-vimeo"
              allow="autoplay; encrypted-media"
              allowfullscreen
              title="{{ alt }}"
            ></iframe>
          {%- endif -%}
        {%- else -%}
          {{
            section.settings.video
            | video_tag:
              image_size: '1100x',
              autoplay: true,
              loop: section.settings.enable_video_looping,
              controls: true,
              muted: false
          }}
        {%- endif -%}
      </template>
    </deferred-media>
  </div>
</div>

{% schema %}
{
  "name": "Cesar · Vídeo",
  "tag": "section",
  "class": "cesar-video-section",
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "Vídeo alojado en Shopify"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "accept": ["youtube", "vimeo"],
      "label": "O enlace de YouTube / Vimeo",
      "info": "Sólo se usa si arriba no hay vídeo alojado."
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "Imagen de portada",
      "info": "Se ve antes de pulsar. Sin ella se usa la miniatura del vídeo."
    },
    {
      "type": "text",
      "id": "description",
      "label": "Descripción del vídeo",
      "info": "No se ve: la leen los lectores de pantalla y describe lo que ocurre en el vídeo."
    },
    {
      "type": "checkbox",
      "id": "enable_video_looping",
      "label": "Reproducir en bucle",
      "default": false
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Proporción",
      "options": [
        { "value": "wide", "label": "Panorámica (21:9)" },
        { "value": "video", "label": "Vídeo (16:9)" },
        { "value": "screen", "label": "Pantalla completa" }
      ],
      "default": "video"
    },
    {
      "type": "header",
      "content": "Botón de reproducción"
    },
    {
      "type": "text",
      "id": "play_label",
      "label": "Texto del botón",
      "default": "Play"
    },
    {
      "type": "color",
      "id": "play_bg",
      "label": "Fondo del botón"
    },
    {
      "type": "color",
      "id": "play_text",
      "label": "Texto del botón"
    },
    {
      "type": "range",
      "id": "play_px",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Tamaño del texto del botón",
      "default": 0,
      "info": "0 = el del tema."
    },
    {
      "type": "header",
      "content": "Texto sobre el vídeo"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titular"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Alineación del texto",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Ancho"
    },
    {
      "type": "checkbox",
      "id": "limit_width",
      "label": "Limitar el ancho del contenido",
      "default": false,
      "info": "Sin marcar, el vídeo ocupa todo el ancho de la pantalla."
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 2000,
      "step": 20,
      "unit": "px",
      "label": "Ancho máximo",
      "default": 1400
    },
    {
      "type": "header",
      "content": "Colores y tamaños"
    },
    {
      "type": "paragraph",
      "content": "Todos opcionales. Vacíos o en 0, la sección usa su esquema de color y la escala tipográfica del tema."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Fondo"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Titular"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Texto"
    },
    {
      "type": "range",
      "id": "heading_px",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Tamaño del titular",
      "default": 0,
      "info": "0 = el del tema."
    },
    {
      "type": "range",
      "id": "text_px",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Tamaño del texto",
      "default": 0,
      "info": "0 = el del tema."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Cesar · Vídeo"
    }
  ]
}
{% endschema %}
