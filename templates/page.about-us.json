        "ratio": "portrait",
        "limit_width": true,
        "max_width": 1200,
        "color_scheme": "scheme-1"
      },
      "blocks": {
        "m-1": {
          "type": "member",
          "settings": {
            "name": "Cesar Mendieta",
            "role": "Founder",
            "bio": "<p>Cesar founded the business on his family's coffee-growing heritage in Colombia, bringing direct-from-origin sourcing and roasting to Melbourne.</p>"
          }
        },
        "m-2": {
          "type": "member",
          "settings": {
            "name": "Carlos Gallo",
            "role": "Head of Coffee",
